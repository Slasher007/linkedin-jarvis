{
  "name": "jarvis-network-scanner-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Unit (jsdom) and end-to-end (real Chrome) tests for the Jarvis Network Scanner extension",
  "scripts": {
    "test": "node --test --test-concurrency=1 unit.test.js e2e.test.js",
    "test:unit": "node --test --test-concurrency=1 unit.test.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=300000 e2e.test.js",
    "certs": "openssl req -x509 -newkey rsa:2048 -nodes -keyout fixtures/key.pem -out fixtures/cert.pem -days 2 -subj \"/CN=www.linkedin.com\" -addext \"subjectAltName=DNS:www.linkedin.com,DNS:brixhub.to\""
  },
  "license": "ISC",
  "dependencies": {
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0"
  }
}
