{
  "manifest_version": 3,
  "name": "Jarvis Network Scanner",
  "version": "1.0.0",
  "description": "Hover LinkedIn Grow cards to auto-search people on BrixHub and display results in a futuristic Jarvis dashboard.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://brixhub.to/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": ["src/content/linkedin.js"],
      "css": ["src/styles/linkedin-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://brixhub.to/*"],
      "js": ["src/content/brixhub.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Jarvis Network Scanner",
    "default_popup": "src/dashboard/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/dashboard/*",
        "src/styles/*",
        "icons/*"
      ],
      "matches": ["https://www.linkedin.com/*", "https://brixhub.to/*"]
    }
  ]
}
